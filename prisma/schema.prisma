generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum AccessoryUrgency {
  immediate
  medium
  low
}

enum AccessoryStatus {
  pending
  purchased
  cancelled
}

enum BikeIssueStatus {
  open
  resolved
}

model User {
  id             String   @id
  name           String
  email          String   @unique
  password       String
  // { url, publicId } — same shape as BikeAccessory.productImage (spec 53)
  profilePicture Json?
  isDeleted      Boolean  @default(false)
  userRole       Role     @default(user)
  expoPushToken  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bikes            Bike[]
  maintenanceTypes MaintenanceType[]
  engineOilTypes   EngineOilType[]

  @@map("users")
}

model Bike {
  id                           String    @id
  ownerId                      String
  nickname                     String
  brand                        String
  model                        String
  registrationNumber           String
  purchaseDate                 DateTime
  fuelTankCapacityLiters       Float
  currentOdometer              Float     @default(0)
  initialOdometer              Float     @default(0)
  isDeleted                    Boolean   @default(false)
  aiSpendingInsight            String?
  aiSpendingInsightLogCount    Int?
  aiMileageInsight             String?
  aiMileageInsightFuelLogCount Int?
  manual                       Json?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id])
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
  engineOilLogs   EngineOilLog[]
  mileageRecords  MileageRecord[]
  issues          BikeIssue[]
  accessories     BikeAccessory[]
  documents       BikeDocument[]
  manualChunks    BikeManualChunk[]

  @@index([ownerId])
  @@map("bikes")
}

model MaintenanceType {
  id                  String   @id
  ownerId             String
  name                String
  defaultIntervalKm   Int?
  defaultIntervalDays Int?
  requiresOilType     Boolean  @default(false)
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id])
  maintenanceLogs MaintenanceLog[]

  // ! The unique deliberately covers soft-deleted rows (no partial index on isDeleted).
  // ! That is what keeps the revive-by-name path in createMaintenanceTypeIntoDB
  // ! load-bearing — see spec 46 §B.
  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("maintenance_types")
}

model EngineOilType {
  id                  String   @id
  ownerId             String
  name                String
  suggestedIntervalKm Float
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id])
  maintenanceLogs MaintenanceLog[]
  engineOilLogs   EngineOilLog[]

  // ! Same rationale as MaintenanceType — the unique covers soft-deleted rows so the
  // ! owner-scoped revive path in createEngineOilTypeIntoDB stays load-bearing (§B).
  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("engine_oil_types")
}

model FuelLog {
  id              String   @id
  bikeId          String
  odometerReading Float
  litersAdded     Float
  isFullTank      Boolean
  pricePerLiter   Decimal  @db.Decimal(12, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  fuelStation     String?
  date            DateTime
  notes           String?
  receiptImage    Json?
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])

  @@index([bikeId])
  @@map("fuel_logs")
}

model MaintenanceLog {
  id                String    @id
  bikeId            String
  maintenanceTypeId String
  oilTypeId         String?
  odometerReading   Float
  intervalKmUsed    Float?
  nextDueOdometer   Float?
  nextDueDate       DateTime?
  cost              Decimal   @db.Decimal(12, 2)
  serviceDate       DateTime
  serviceCenter     String?
  partsReplaced     String[]
  notes             String?
  serviceImage      Json?
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bike            Bike            @relation(fields: [bikeId], references: [id])
  maintenanceType MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])
  oilType         EngineOilType?  @relation(fields: [oilTypeId], references: [id])

  @@index([bikeId])
  @@map("maintenance_logs")
}

// Spec 54: an oil change is its own record now, not a maintenance log with an oil type
// bolted on. Carries the two oil-specific fields that had nowhere to live in
// `maintenance_logs` (quantityLiters, oilFilterChanged) plus the provenance column the
// import writes.
model EngineOilLog {
  id                           String    @id
  bikeId                       String
  // ! H7/D2: nullable in the DB so the import can carry rows that never had a type
  // ! (MaintenanceLog.oilType is optional today, so such rows legitimately exist);
  // ! createEngineOilLogSchema REQUIRES it for everything entered from now on. The two
  // ! rules differ on purpose — don't "fix" either one to match the other.
  oilTypeId                    String?
  odometerReading              Float
  // ! H6/D3: normally client-seeded from the oil type and editable by the rider, then
  // ! FROZEN on the row. Never re-derived from the catalog on read — editing a catalog
  // ! row would otherwise retroactively move the due point of every past change.
  intervalKmUsed               Float?
  nextDueOdometer              Float?
  quantityLiters               Float?
  oilFilterChanged             Boolean   @default(false)
  cost                         Decimal   @db.Decimal(12, 2)
  changeDate                   DateTime
  serviceCenter                String?
  notes                        String?
  receiptImage                 Json?
  // ! D9: provenance for spec 54 §H's import. Unique, so a second --apply is a no-op.
  // ! NULL is not unique-constrained in Postgres, so every hand-entered row (NULL here)
  // ! is unaffected — the index only binds the imported ones.
  importedFromMaintenanceLogId String?   @unique
  isDeleted                    Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])
  // ! H2 — Restrict, deliberately NOT the SetNull that maintenance_logs.oilTypeId carries
  // ! (init migration L259, spec 46 H1): there, hard-deleting a still-referenced oil type
  // ! succeeds and silently nulls every log pointing at it. An optional Prisma relation
  // ! defaults to SetNull, so this argument is what stops the new table inheriting that bug.
  oilType EngineOilType? @relation(fields: [oilTypeId], references: [id], onDelete: Restrict)

  @@index([bikeId])
  @@index([bikeId, changeDate])
  @@map("engine_oil_logs")
}

model MileageRecord {
  id                String   @id
  bikeId            String
  startOdometer     Float
  endOdometer       Float
  distanceKm        Float
  litersConsumed    Float
  mileageKmPerLiter Float
  periodStartDate   DateTime
  periodEndDate     DateTime
  fuelLogIds        String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])

  @@index([bikeId])
  @@map("mileage_records")
}

model BikeIssue {
  id           String          @id
  bikeId       String
  title        String
  description  String?
  dateReported DateTime
  status       BikeIssueStatus @default(open)
  images       Json?
  isDeleted    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])

  @@index([bikeId])
  @@map("bike_issues")
}

model BikeAccessory {
  id           String           @id
  bikeId       String
  name         String
  urgency      AccessoryUrgency
  status       AccessoryStatus  @default(pending)
  price        Decimal?         @db.Decimal(12, 2)
  purchaseDate DateTime?
  productImage Json?
  isDeleted    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])

  @@index([bikeId])
  @@map("bike_accessories")
}

model BikeDocument {
  id          String    @id
  bikeId      String
  title       String
  description String?
  expiryDate  DateTime?
  files       Json?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])

  @@index([bikeId])
  @@map("bike_documents")
}

model BikeManualChunk {
  id         String   @id
  bikeId     String
  chunkIndex Int
  chunkText  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bike Bike @relation(fields: [bikeId], references: [id])

  @@index([bikeId])
  @@map("bike_manual_chunks")
}

model ErrorLog {
  id           String   @id
  status       Int
  message      String
  errorName    String?
  errorSources Json?
  stack        String?
  method       String
  path         String
  userId       String?
  userEmail    String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@map("error_logs")
}
