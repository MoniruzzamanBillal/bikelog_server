# Template for bikelog_server's .env — copy to .env and fill in real values.
#
# Authoritative list: src/app/config/index.ts (plus DATABASE_URL_UNPOOLED, which only
# prisma.config.ts reads). ENV_SETUP.md is prose; this file and config/index.ts are the
# machine-checkable pair.
#
# FORMAT MATTERS: write KEY=value with no spaces around the `=`. The npm dotenv package
# trims whitespace around keys, so `KEY = value` works for `yarn dev` — but Compose's
# env_file parser is a different implementation, and a key that arrives as "KEY " leaves
# process.env.KEY undefined. For JWT_ACCESS_SECRET that silently 401s every authenticated
# request while the container still reports healthy.

# ---- server ----
PORT=5000
NODE_ENV=development

# ---- database (Neon Postgres) ----
# Runtime, pooled. Read by the PrismaNeon adapter in src/app/lib/prisma.ts at module import
# time, so a missing or malformed value fails before src/server.ts's try/catch.
# Must be a real Neon host — the serverless adapter speaks WebSocket and cannot point at a
# local Postgres instance.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Migrations only, direct/unpooled. Read by prisma.config.ts, never by the app.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---- auth ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
# Optional — src/app/config/index.ts defaults this to "10d".
JWT_EXPIRES_IN=10d

# ---- AI (OpenRouter) ----
# NOTE the lowercase camelCase name. config/index.ts reads process.env.openRouterApiKey,
# not OPENROUTER_API_KEY. Easy to mistype; the `ai` module is live and needs it.
openRouterApiKey=sk-or-v1-...

# ---- image/file uploads (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- scheduled jobs ----
# Shared secret for POST /api/cron/weekly-summary and POST /api/cron/cleanup-error-logs.
# Both routes skip authCheck deliberately and compare this against the x-cron-secret
# header, so an unset value means they compare against undefined. For the deployed backend
# this must be byte-identical to the CRON_SECRET repository secret used by
# .github/workflows/weekly-summary-cron.yml and daily-error-log-cleanup.yml.
CRON_SECRET=replace-with-a-long-random-string

# ---- outbound sync to expenseTracker2 (context/specs/30-...) ----
# EXPENSE_TRACKER_INTEGRATION_KEY must be byte-identical to expenseTracker2's
# INTEGRATION_API_KEY.
EXPENSE_TRACKER_BASE_URL=https://your-expense-tracker.example.com
EXPENSE_TRACKER_INTEGRATION_KEY=replace-with-the-shared-integration-key

# ---- not required ----
# MONGO_DATABASE_URL is vestigial: config/index.ts still exposes it, but its only consumer
# was the mongoose.connect() call that src/server.ts now keeps commented out. The
# MongoDB -> Postgres migration is complete; omit it.
